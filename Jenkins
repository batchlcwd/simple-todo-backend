pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "batchlcwd/todo-backend"
        DOCKER_TAG = "${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Checkout successful'
                echo 'Testing from github webhook...'
                echo "Build number ${BUILD_NUMBER}"
            }
        }
        stage("Test") {
            steps {
                sh '''
                chmod +x ./mvnw
                ./mvnw test
                '''
            }
        }
        stage("Build") {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }
        stage("Docker build") {
            steps {
                sh """
                            docker build \
                            -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                    """
            }
        }
    }
}
